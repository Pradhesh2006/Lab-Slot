# LabSlot configuration — copy this file to ".env" and fill in your values.
# Never commit ".env" (it is excluded by .gitignore and by make_zip.py).

# Google AI Studio key used by the RAG answer-generation step (google-genai).
# If left empty, LabSlot falls back to an offline extractive answer built
# directly from the retrieved knowledge-base chunks.
GCP_API_KEY=your_actual_api_key_here

# Gemini model used for grounded generation.
GEMINI_MODEL=gemini-2.5-flash

# Flask session signing key. Use a long random string in any shared deployment.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Optional: SQLite file location (defaults to ./labslot.db).
DATABASE_PATH=labslot.db

# Optional: set to 1 to run Flask in debug mode (development only).
FLASK_DEBUG=0
